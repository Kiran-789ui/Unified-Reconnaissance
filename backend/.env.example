# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Use local MongoDB, MongoDB Atlas URI, or leave empty/set USE_IN_MEMORY_DB=true for auto in-memory database
MONGODB_URI=mongodb://127.0.0.1:27017/unified-recon-db
USE_IN_MEMORY_DB=false

# Authentication Secrets
JWT_SECRET=super_secret_jwt_key_recon_platform_2026_secure
JWT_EXPIRES_IN=7d

# CORS Configuration
CLIENT_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Reconnaissance & External Provider Settings
REQUEST_TIMEOUT_MS=8000
# Optional external IP metadata API key (e.g., ipinfo.io, ipapi.co). If omitted, platform uses safe free public endpoints or fallback.
IPINFO_TOKEN=
